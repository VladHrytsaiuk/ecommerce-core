PORT=8080
# Store-level configuration. This is a clean ecommerce-core deployment; do not
# put a store identity or business rule in Go code. Values for adapters/modules
# not implemented yet are rejected at startup.
STORE_CODE=default-store
STORE_NAME=Ecommerce Core Store
DEFAULT_LOCALE=uk
SUPPORTED_LOCALES=uk,en
FALLBACK_LOCALE=uk
CURRENCY=UAH
PRICE_SCALE=2
# Supported modes: none, vat_included, vat_excluded. VAT_RATE is an integer percentage.
TAX_MODE=none
VAT_RATE=0
PAYMENT_PROVIDERS=
PAYMENT_DEFAULT=
# Example: SHIPPING_PROVIDERS=novaposhta and SHIPPING_DEFAULT=novaposhta.
# DHL Express is also available as `dhlexpress`; it requires MyDHL credentials.
# Only enabled providers are initialized by Bootstrap.
SHIPPING_PROVIDERS=
SHIPPING_DEFAULT=
INVENTORY_MODE=internal
# Add user_profiles only together with PROFILE_POLICY_JSON below.
# Optional modules: customers enables the JWT-scoped customer profile and
# address book; admin enables data-driven RBAC plus the audited
# Admin Facades and audited routes; the SuperAdmin role is seeded by the Admin
# module migrations and assigned with `cmd/cli grant-superadmin`; user_profiles requires
# PROFILE_POLICY_JSON; wishlist and
# comparison use the existing cart_session cookie; reviews adds moderation and
# a Catalog rating projection; seo and badges enrich Catalog responses; promos
# applies checkout discounts and reserves usage atomically with an order. Add
# `orders,admin` to enable the configurable operational order workflow and
# its audited status-transition endpoint.
ENABLED_MODULES=inventory
# Per-category maximum for the optional `comparison` module. It is validated
# at startup only when `comparison` is enabled.
COMPARISON_MAX_ITEMS=5
# UUID of an active inventory warehouse. Checkout always reserves cart items
# there until a future inventory-allocation policy is enabled.
DEFAULT_WAREHOUSE_ID=00000000-0000-4000-8000-000000000001
CHECKOUT_ALLOW_GUEST=true
CHECKOUT_REQUIRE_PHONE=true
# Verified-contact policy applies only to authenticated customers. Keep both
# false unless your Identity verification flows are enabled for this deployment.
CHECKOUT_REQUIRE_VERIFIED_EMAIL=false
CHECKOUT_REQUIRE_VERIFIED_PHONE=false
# Requires ENABLED_MODULES to include customers. Comma-separated typed
# profile fields (date_of_birth, gender) or configured metadata keys.
CHECKOUT_REQUIRED_PROFILE_FIELDS=
# Shared deadline for the payment attempt, pending order and inventory hold.
# After it expires the background worker atomically cancels the order and
# releases inventory plus optional promo reservations.
CHECKOUT_RESERVATION_TTL=15m

# Оточення застосунку. На проді ОБОВ'ЯЗКОВО production (або лиште порожнім).
# Лише development|local дозволяють повертати OTP-код у відповіді /verify-phone/request (для тестів).
APP_ENV=production
# Верхня межа тривалості обробки HTTP-запиту (Go duration: 30s, 1m тощо).
# Має покривати повільні операції — напр., завантаження кількох зображень товару в Cloudinary.
# За замовчуванням: 30s.
HTTP_REQUEST_TIMEOUT=30s

# Private management listener: expose only to the orchestration/network plane.
MANAGEMENT_ADDR=127.0.0.1:9090

# Distributed tracing is opt-in. OTEL_EXPORTER_OTLP_ENDPOINT must be host:port
# (for example, otel-collector:4318) when OTEL_ENABLED=true.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Meilisearch projection. Required only when ENABLED_MODULES includes
# `search`; never expose SEARCH_MASTER_KEY to storefront clients.
SEARCH_URL=http://localhost:7700
SEARCH_MASTER_KEY=
SEARCH_INDEX_PREFIX=ecommerce

# Optional CQRS business-analytics module. Use an IANA timezone for daily
# revenue buckets, for example UTC or Europe/Kyiv.
REPORTS_TIMEZONE=UTC

# Outbox delivery maintenance. Successfully completed deliveries are archived
# in bounded batches; immutable domain_events remain available to Audit/Reports.
OUTBOX_DONE_RETENTION=720h
OUTBOX_RETENTION_INTERVAL=1h

# Optional Media module. Add `media,admin` to ENABLED_MODULES. S3-compatible
# storage supports AWS S3, MinIO and Cloudflare R2; Cloudinary is selected by
# MEDIA_PROVIDER=cloudinary. Never expose provider credentials to clients.
# Local MinIO: docker compose --profile media up
MEDIA_PROVIDER=minio
MEDIA_S3_BUCKET=ecommerce-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_USE_PATH_STYLE=true
MEDIA_S3_PUBLIC_BASE_URL=http://localhost:9000/ecommerce-media
# For Cloudflare R2 set MEDIA_PROVIDER=r2 and configure its public custom domain.
MEDIA_R2_PUBLIC_BASE_URL=
# Required for MEDIA_PROVIDER=cloudinary.
MEDIA_CLOUDINARY_URL=
# Required only for `docker compose --profile observability up`.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Per-source-IP limits. Sensitive applies to checkout and login; API applies
# to every /api route, including webhook delivery.
API_RATE_LIMIT_PER_MINUTE=100
SENSITIVE_RATE_LIMIT_PER_MINUTE=10
# Optional Redis capability. Redis is used only for cache and distributed
# login rate limiting; PostgreSQL remains the source of truth and Outbox store.
# When disabled, caching is a no-op and login limiting safely falls back to a
# per-process limiter (not shared across replicas).
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
REFRESH_TOKEN_DURATION=168h
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
# Used only by `go run ./cmd/cli create-owner`; do not commit a real password.
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=replace-with-a-long-unique-password

# Optional Google OAuth. Leave all three variables empty to keep the adapter
# completely disabled. GOOGLE_REDIRECT_URI must match Google Cloud exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OAUTH_ATTEMPT_TTL=10m
# Optional customer profile schema. Enable `user_profiles` in ENABLED_MODULES
# before setting this. Keep it as a single JSON object on one line.
# PROFILE_POLICY_JSON={"schema_version":1,"fields":[{"key":"birth_date","type":"date","customer_writable":true}]}

# Optional Returns / RMA module. Add `returns` to ENABLED_MODULES to enable
# the policy. The window is measured in calendar days after delivery (with a
# payment-time fallback only for historic orders without delivery timestamps).
RETURN_WINDOW=14

# Optional abandoned-cart campaign. Add `checkout,notifications,consent,abandoned_cart`
# to ENABLED_MODULES only after configuring at least one delay. Durations use Go syntax.
ABANDONED_CART_DELAYS=
ABANDONED_CART_MAX_REMINDERS=0
ABANDONED_CART_REQUIRE_MARKETING_CONSENT=true
ABANDONED_CART_QUIET_HOURS=
# Docker Compose starter database. For an external managed PostgreSQL instance,
# replace DB_URL with its connection string and do not start the local postgres service.
POSTGRES_DB=ecommerce_core
POSTGRES_USER=ecommerce_core
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DB_URL=postgres://ecommerce_core:replace-with-a-long-unique-password@postgres:5432/ecommerce_core?sslmode=disable

# SendGrid (Email) — рекомендований варіант
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=Ecommerce Core Store <no-reply@example.com>

# SMTP (Email) — альтернатива, якщо не використовуєте SendGrid
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=AquaWheel Store <your-email@gmail.com>
# Required TLS mode for the transactional SMTP sender: `starttls` (port 587)
# or `implicit` (SMTPS port 465). The default is fail-closed STARTTLS.
SMTP_TLS_MODE=starttls

# Optional transactional Notifications module. Add `notifications` to
# ENABLED_MODULES to consume receipts from the durable outbox. Notification
# job payloads are encrypted at rest with a base64-encoded 32-byte AES-256 key
# (generate it with: openssl rand -base64 32). The key is required whenever
# the module is enabled, including with the local mock sender.
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_ENCRYPTION_KEY=
# Supported provider values: mock, smtp, ses. `ses` is a safe integration
# placeholder until its AWS SDK credentials adapter is installed.

# Nova Poshta (Shipping — довідники: області, міста, відділення)
NOVA_POSHTA_API_KEY=your-nova-poshta-api-key

# Nova Poshta Sender (для створення ТТН — дані з особистого кабінету НП)
NP_SENDER_REF=your-sender-counterparty-ref
NP_SENDER_CITY_REF=your-sender-city-ref
NP_SENDER_ADDRESS_REF=your-sender-warehouse-ref
NP_CONTACT_SENDER_REF=your-contact-person-ref
NP_SENDER_PHONE=+380XXXXXXXXX

# DHL Express / MyDHL API. An active DHL Express business account and API
# credentials are required. The default base URL is DHL's test environment;
# set DHL_EXPRESS_BASE_URL=https://express.api.dhl.com/mydhlapi only for live
# shipments. This initial adapter supports domestic shipments; international
# shipping is intentionally blocked until a customs-item module exists.
# DHL_EXPRESS_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_EXPRESS_USERNAME=
DHL_EXPRESS_PASSWORD=
DHL_EXPRESS_ACCOUNT_NUMBER=
# Product code enabled for this account, e.g. P. It is configured rather than
# stored in the order because delivery jobs contain only neutral data.
DHL_EXPRESS_PRODUCT_CODE=
DHL_EXPRESS_SENDER_NAME=
DHL_EXPRESS_SENDER_PHONE=
DHL_EXPRESS_SENDER_COUNTRY=
DHL_EXPRESS_SENDER_POSTAL=
DHL_EXPRESS_SENDER_CITY=
DHL_EXPRESS_SENDER_LINE1=
# Dimensions in centimetres of the standard parcel used by this store.
DHL_EXPRESS_PACKAGE_LENGTH_CM=
DHL_EXPRESS_PACKAGE_WIDTH_CM=
DHL_EXPRESS_PACKAGE_HEIGHT_CM=

# Cloudinary (зображення)
STORE_LOGO_URL=https://example.com/store-logo.png

# LiqPay (payment adapter; enable with PAYMENT_PROVIDERS=liqpay and
# PAYMENT_DEFAULT=liqpay)
LIQPAY_PUBLIC_KEY=your-liqpay-public-key
LIQPAY_PRIVATE_KEY=your-liqpay-private-key
# Required only when PAYMENT_PROVIDERS includes liqpay.
LIQPAY_CALLBACK_URL=https://api.example.com/api/webhooks/payments/liqpay

# Monobank acquiring (enable with PAYMENT_PROVIDERS=monobank and
# PAYMENT_DEFAULT=monobank). Monobank invoices are UAH-only, so use
# CURRENCY=UAH and PRICE_SCALE=2. The public key is base64-encoded PEM from
# GET /api/merchant/pubkey; it verifies the ECDSA X-Sign webhook header.
MONOBANK_TOKEN=your-monobank-merchant-token
MONOBANK_WEBHOOK_PUBLIC_KEY=base64-encoded-pem-public-key
MONOBANK_API_URL=https://api.monobank.ua
MONOBANK_WEBHOOK_URL=https://api.example.com/api/webhooks/payments/monobank

# Stripe (payment adapter; enable with PAYMENT_PROVIDERS=stripe and
# PAYMENT_DEFAULT=stripe). The webhook endpoint is the generic
# /api/webhooks/payments/stripe route.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Redsys (Spain; enable with PAYMENT_PROVIDERS=redsys and PAYMENT_DEFAULT=redsys).
# REDSYS_CURRENCY_CODE is the provider numeric ISO 4217 code (EUR=978).
REDSYS_MERCHANT_CODE=your-fuc
REDSYS_TERMINAL=001
REDSYS_SECRET_KEY=your-terminal-signing-key
REDSYS_CALLBACK_URL=https://api.example.com/api/webhooks/payments/redsys
REDSYS_CURRENCY_CODE=978

# Сповіщення
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Manager (менеджерська сторінка для обробки замовлень)
# Якщо не вказано — використовується API_HOST
MANAGER_BASE_URL=http://localhost:8080

# Rate Limiting
EMAIL_RATE_LIMIT=2
EMAIL_RATE_INTERVAL=3m
# Comma-separated ingress proxy IPs/CIDRs only. Never set this to `all`:
# trusted proxies determine whether X-Forwarded-For can influence abuse limits.
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOW_ORIGINS=http://domen1,https://domen2,....

# Vodafone OBM (SMS — верифікація номера телефону)
# Якщо OBM_USERNAME / OBM_PASSWORD / OBM_SENDER_ID не задані — використовується консольний мок (dev).
OBM_USERNAME=your-obm-login
OBM_PASSWORD=your-obm-password
OBM_SENDER_ID=your-obm-sender-id
OBM_DISTRIBUTION_ID=your-obm-distribution-id
OBM_VALIDITY_MINUTES=2
# Перевірка статусу доставки в логах (DELIVERED/REJECTED). Вимкнути: false
OBM_STATUS_CHECK=true
# Час життя OTP-коду в БД (синхронно з OBM_VALIDITY_MINUTES)
PHONE_CODE_TTL=2m
# Опціонально (мають робочі дефолти):
# OBM_BASE_URL=https://a2p.vodafone.ua
# OBM_TOKEN_PATH=/uaa/oauth/token
# OBM_BASIC_AUTH_HEADER=Basic d2ViYXBwOndlYmFwcA==
