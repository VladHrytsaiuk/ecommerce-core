PORT=8080
# Store-level configuration. This is a clean ecommerce-core deployment; do not
# put a store identity or business rule in Go code. Values for adapters/modules
# not implemented yet are rejected at startup.
STORE_CODE=default-store
STORE_NAME=Ecommerce Core Store
DEFAULT_LOCALE=uk
SUPPORTED_LOCALES=uk,en
FALLBACK_LOCALE=uk
CURRENCY=UAH
PRICE_SCALE=2
# Supported modes: none, vat_included, vat_excluded. VAT_RATE is an integer percentage.
TAX_MODE=none
VAT_RATE=0
PAYMENT_PROVIDERS=
PAYMENT_DEFAULT=
# Example: SHIPPING_PROVIDERS=novaposhta and SHIPPING_DEFAULT=novaposhta.
# Only enabled providers are initialized by Bootstrap.
SHIPPING_PROVIDERS=
SHIPPING_DEFAULT=
INVENTORY_MODE=internal
ENABLED_MODULES=inventory
# UUID of an active inventory warehouse. Checkout always reserves cart items
# there until a future inventory-allocation policy is enabled.
DEFAULT_WAREHOUSE_ID=00000000-0000-4000-8000-000000000001
CHECKOUT_ALLOW_GUEST=true
CHECKOUT_REQUIRE_PHONE=true
CHECKOUT_RESERVATION_TTL=15m

# Оточення застосунку. На проді ОБОВ'ЯЗКОВО production (або лиште порожнім).
# Лише development|local дозволяють повертати OTP-код у відповіді /verify-phone/request (для тестів).
APP_ENV=production
# Верхня межа тривалості обробки HTTP-запиту (Go duration: 30s, 1m тощо).
# Має покривати повільні операції — напр., завантаження кількох зображень товару в Cloudinary.
# За замовчуванням: 30s.
HTTP_REQUEST_TIMEOUT=30s
# Per-source-IP limits. Sensitive applies to checkout and login; API applies
# to every /api route, including webhook delivery.
API_RATE_LIMIT_PER_MINUTE=100
SENSITIVE_RATE_LIMIT_PER_MINUTE=10
FRONTEND_URL=http://localhost:3000
REFRESH_TOKEN_DURATION=168h
# Required. Generate with: openssl rand -base64 48
JWT_SECRET=
# Used only by `go run ./cmd/cli create-owner`; do not commit a real password.
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=replace-with-a-long-unique-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Docker Compose starter database. For an external managed PostgreSQL instance,
# replace DB_URL with its connection string and do not start the local postgres service.
POSTGRES_DB=ecommerce_core
POSTGRES_USER=ecommerce_core
POSTGRES_PASSWORD=replace-with-a-long-unique-password
DB_URL=postgres://ecommerce_core:replace-with-a-long-unique-password@postgres:5432/ecommerce_core?sslmode=disable

# SendGrid (Email) — рекомендований варіант
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=Ecommerce Core Store <no-reply@example.com>

# SMTP (Email) — альтернатива, якщо не використовуєте SendGrid
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=AquaWheel Store <your-email@gmail.com>

# Nova Poshta (Shipping — довідники: області, міста, відділення)
NOVA_POSHTA_API_KEY=your-nova-poshta-api-key

# Nova Poshta Sender (для створення ТТН — дані з особистого кабінету НП)
NP_SENDER_REF=your-sender-counterparty-ref
NP_SENDER_CITY_REF=your-sender-city-ref
NP_SENDER_ADDRESS_REF=your-sender-warehouse-ref
NP_CONTACT_SENDER_REF=your-contact-person-ref
NP_SENDER_PHONE=+380XXXXXXXXX

# Cloudinary (зображення)
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
STORE_LOGO_URL=https://example.com/store-logo.png

# LiqPay (payment adapter; enable with PAYMENT_PROVIDERS=liqpay and
# PAYMENT_DEFAULT=liqpay)
LIQPAY_PUBLIC_KEY=your-liqpay-public-key
LIQPAY_PRIVATE_KEY=your-liqpay-private-key
# Required only when PAYMENT_PROVIDERS includes liqpay.
LIQPAY_CALLBACK_URL=https://api.example.com/api/webhooks/payments/liqpay

# Stripe (payment adapter; enable with PAYMENT_PROVIDERS=stripe and
# PAYMENT_DEFAULT=stripe). The webhook endpoint is the generic
# /api/webhooks/payments/stripe route.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Redsys (Spain; enable with PAYMENT_PROVIDERS=redsys and PAYMENT_DEFAULT=redsys).
# REDSYS_CURRENCY_CODE is the provider numeric ISO 4217 code (EUR=978).
REDSYS_MERCHANT_CODE=your-fuc
REDSYS_TERMINAL=001
REDSYS_SECRET_KEY=your-terminal-signing-key
REDSYS_CALLBACK_URL=https://api.example.com/api/webhooks/payments/redsys
REDSYS_CURRENCY_CODE=978

# Сповіщення
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Manager (менеджерська сторінка для обробки замовлень)
# Якщо не вказано — використовується API_HOST
MANAGER_BASE_URL=http://localhost:8080

# Rate Limiting
EMAIL_RATE_LIMIT=2
EMAIL_RATE_INTERVAL=3m
TRUSTED_PROXIES=127.0.0.1
CORS_ALLOW_ORIGINS=http://domen1,https://domen2,....

# Vodafone OBM (SMS — верифікація номера телефону)
# Якщо OBM_USERNAME / OBM_PASSWORD / OBM_SENDER_ID не задані — використовується консольний мок (dev).
OBM_USERNAME=your-obm-login
OBM_PASSWORD=your-obm-password
OBM_SENDER_ID=your-obm-sender-id
OBM_DISTRIBUTION_ID=your-obm-distribution-id
OBM_VALIDITY_MINUTES=2
# Перевірка статусу доставки в логах (DELIVERED/REJECTED). Вимкнути: false
OBM_STATUS_CHECK=true
# Час життя OTP-коду в БД (синхронно з OBM_VALIDITY_MINUTES)
PHONE_CODE_TTL=2m
# Опціонально (мають робочі дефолти):
# OBM_BASE_URL=https://a2p.vodafone.ua
# OBM_TOKEN_PATH=/uaa/oauth/token
# OBM_BASIC_AUTH_HEADER=Basic d2ViYXBwOndlYmFwcA==
